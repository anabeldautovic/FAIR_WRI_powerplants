# Follow the owl:sameAs links into Wikidata (federated query): for US nuclear
# plants, combine our capacity with the operator recorded in Wikidata.
# The SERVICE part only asks Wikidata about nuclear power plants (a small set),
# so it also works on endpoints that do not pass our bindings to Wikidata.
# Needs an endpoint that allows SERVICE calls (e.g. Fuseki with SERVICE enabled).
PREFIX dbo:     <http://dbpedia.org/ontology/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX wdt:     <http://www.wikidata.org/prop/direct/>
PREFIX fuel:    <https://w3id.org/gppd-ld/fuel/>

SELECT ?name (?watts / 1e6 AS ?megawatts) ?item ?operatorName
WHERE {
  SERVICE <https://query.wikidata.org/sparql> {
    ?item wdt:P31 wd:Q134447 ;          # instance of: nuclear power plant
          wdt:P10682 [] ;               # has an EIA plant id
          wdt:P137 ?operator .          # operator
    ?operator rdfs:label ?operatorName .
    FILTER (LANG(?operatorName) = "en")
  }
  ?plant owl:sameAs ?item ;
         dbo:primaryFuelType fuel:Nuclear ;
         dcterms:title ?name ;
         dbo:installedCapacity ?watts .
}
ORDER BY DESC(?watts)
LIMIT 20
