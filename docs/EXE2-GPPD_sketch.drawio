<mxfile host="app.diagrams.net"><diagram name="GPPD EXE2 sketch" id="gppd-ldap"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0" value="" /><mxCell id="1" parent="0" value="" /><mxCell id="title" value="GPPD: classes and properties sketch (EXE 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="pt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;sf:Point&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;plant location (also geo:Geometry)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;geo:asWKT, POINT(longitude latitude)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="300" height="80" as="geometry" /></mxCell><mxCell id="og" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;prov:Organization&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;owner or data source&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;rdfs:label (name)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="300" height="70" as="geometry" /></mxCell><mxCell id="ct" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;dbo:Country&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;country of the plant&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;dcterms:identifier (ISO alpha-3 code)&lt;br&gt;rdfs:label (country name)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="385" width="300" height="80" as="geometry" /></mxCell><mxCell id="pp" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;dbo:PowerStation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;one per CSV row (also geo:Feature, oeo:OEO_00000031)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;dcterms:identifier (ID)&lt;br&gt;dcterms:title (name)&lt;br&gt;dbo:installedCapacity (watts, from MW × 1,000,000)&lt;br&gt;dbo:primaryFuelType → &lt;span style=&quot;color:#2E7D32&quot;&gt;gppd:FuelScheme&lt;/span&gt;&lt;br&gt;dbo:otherFuelType → &lt;span style=&quot;color:#2E7D32&quot;&gt;gppd:FuelScheme&lt;/span&gt; (up to 3)&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;year of capacity data (term to mint)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;commissioning year (term to mint)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="360" height="185" as="geometry" /></mxCell><mxCell id="sd" value="&lt;b&gt;Source document&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;IRI of a web page or ftp file&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="420" width="300" height="60" as="geometry" /></mxCell><mxCell id="id" value="&lt;div style=&quot;text-a