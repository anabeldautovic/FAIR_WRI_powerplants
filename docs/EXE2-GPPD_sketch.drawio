b&gt;Prefix&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;background:#e6edf6;width:25%&quot;&gt;&lt;b&gt;Namespace&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;background:#e6edf6;width:29%&quot;&gt;&lt;b&gt;Terms used&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;background:#e6edf6;width:20%&quot;&gt;&lt;b&gt;Why it fits&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;DBpedia Ontology&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;dbo&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://dbpedia.org/ontology/&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;PowerStation, Country, country, installedCapacity, primaryFuelType, otherFuelType, owner&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Widely used terms made for power stations.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Open Energy Ontology&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;oeo&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://openenergy-platform.org/ontology/oeo/&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;OEO_00000031 (power plant)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Energy-domain ontology; second, more specific plant type.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;GeoSPARQL / Simple Features&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;geo, sf&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://www.opengis.net/ont/geosparql#&lt;br&gt;http://www.opengis.net/ont/sf#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Feature, Geometry, Point, hasGeometry, asWKT&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Standard way to describe a location as a point.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;PROV-O&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;prov&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://www.w3.org/ns/prov#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Organization, wasAttributedTo, hadPrimarySource&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Who provided each piece of data (provenance).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Dublin Core Terms&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;dcterms&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://purl.org/dc/terms/&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;identifier, title, description, license, publisher, source, isPartOf&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;General descriptive metadata.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;ADMS&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;adms&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://www.w3.org/ns/adms#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Identifier, identifier&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Base class for our WEPP identifier class.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;RDF Data Cube&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;qb&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://purl.org/linked-data/cube#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Observation, DataSet, dataSet&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Statistical data: one value per plant and year.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;SDMX (for Data Cube)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;sdmx-dimension, sdmx-measure, sdmx-attribute&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://purl.org/linked-data/sdmx/2009/dimension#&lt;br&gt;…/measure#&lt;br&gt;…/attribute#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;refPeriod, obsValue, unitMeasure&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Standard year, value and unit properties.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;QUDT&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;qudt, unit&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://qudt.org/schema/qudt/&lt;br&gt;http://qudt.org/vocab/unit/&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Unit (GigaW-HR)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Explicit unit for generation.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;DCAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;dcat&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;http://www.w3.org/ns/dcat#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Dataset, distribution, version&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Describing and publishing the dataset.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Our ontology (proposed)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;gppd&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;https://w3id.org/gppd-ld/ontology#&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;commissioningYear, capacityDataYear, plant, estimationMethod, WEPPIdentifier; FuelScheme, EstimationMethodScheme&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top&quot;&gt;Terms with no suitable existing equivalent.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="950" width="1520" height="480" as="geometry" /></mxCell><mxCell id="authors" value="Group 2 · Seminars, Workshop A · Tomás Macedo, Mara Almasan, Anabel Dautovic" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="900" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>