<mxfile host="app.diagrams.net"><diagram name="GPPD LDAP" id="gppd-ldap"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0" value="" /><mxCell id="1" parent="0" value="" /><mxCell id="title" value="GPPD Linked Data Application Profile (EXE 3): application profile diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="pt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;sf:Point&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;plant location (also geo:Geometry)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;geo:asWKT : geo:wktLiteral [1]&lt;br&gt;POINT(longitude latitude)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="300" height="80" as="geometry" /></mxCell><mxCell id="og" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;prov:Organization&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;owner or data source&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;rdfs:label : xsd:string [1]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="300" height="70" as="geometry" /></mxCell><mxCell id="ct" value="&lt;b&gt;country:{ISO alpha-3 code}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;EU countries and territories authority table&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="300" height="60" as="geometry" /></mxCell><mxCell id="pp" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;dbo:PowerStation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;also typed geo:Feature and oeo:OEO_00000031 (power plant)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;dcterms:identifier : xsd:string [1]&lt;br&gt;dcterms:title : xsd:string [1]&lt;br&gt;dbo:installedCapacity : xsd:double, W (capacity_mw × 1,000,000) [1]&lt;br&gt;dbo:primaryFuelType → &lt;span style=&quot;color:#2E7D32&quot;&gt;gppd:FuelScheme&lt;/span&gt; [1]&lt;br&gt;dbo:otherFuelType → &lt;span style=&quot;color:#2E7D32&quot;&gt;gppd:FuelScheme&lt;/span&gt; [0..3]&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:capacityDataYear : xsd:gYear [0..1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:commissioningYear : xsd:decimal [0..1]&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="360" height="190" as="geometry" /></mxCell><mxCell id="sd" value="&lt;b&gt;Source document&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;IRI of a web page or ftp file&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="420" width="300" height="60" as="geometry" /></mxCell><mxCell id="id" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:WEPPIdentifier&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;rdfs:subClassOf adms:Identifier (WEPP identifier)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;skos:notation : xsd:string [1]&lt;br&gt;adms:schemaAgency : &quot;S&amp;P Global Platts WEPP&quot; [1]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="300" height="80" as="geometry" /></mxCell><mxCell id="ds" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;dcat:Dataset&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;our publication (publisher: project group)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;dcterms:title : rdf:langString [1]&lt;br&gt;dcterms:description : rdf:langString [1]&lt;br&gt;dcterms:license : IRI, CC BY 4.0 [1]&lt;br&gt;dcterms:publisher : prov:Organization [1]&lt;br&gt;dcterms:source : IRI, WRI GPPD v1.3.0 [1]&lt;br&gt;dcat:version : xsd:string [1]&lt;br&gt;dcat:distribution : dcat:Distribution [1..n]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="475" width="300" height="180" as="geometry" /></mxCell><mxCell id="ob" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;qb:Observation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;one generation value per plant and year&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;sdmx-dimension:refPeriod : xsd:gYear [1]&lt;br&gt;sdmx-measure:obsValue : xsd:decimal, GWh [1]&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:estimationMethod&lt;/span&gt; → &lt;span style=&quot;color:#2E7D32&quot;&gt;gppd:EstimationMethodScheme&lt;/span&gt; [0..1]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="360" height="120" as="geometry" /></mxCell><mxCell id="qd" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;qb:DataSet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;also dcat:Dataset&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #999999;margin:4px 0 2px 0&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:reportedGeneration&lt;/span&gt; (2013–2019)&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd:estimatedGeneration&lt;/span&gt; (2013–2017)&lt;br&gt;qb:structure : &lt;span style=&quot;color:#B85450&quot;&gt;gppd:generationDSD&lt;/span&gt; [1]&lt;br&gt;dcterms:isPartOf : the main dcat:Dataset [1]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="300" height="110" as="geometry" /></mxCell><mxCell id="un" value="&lt;b&gt;unit:GigaW-HR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;QUDT unit, gigawatt hour&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="830" width="360" height="50" as="geometry" /></mxCell><mxCell id="lg" value="&lt;b&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;Yellow box: class in the profile, with its datatype properties written as &lt;i&gt;property : datatype [cardinality]&lt;/i&gt;&lt;br&gt;Arrow: object property, with its cardinality&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;Red&lt;/span&gt;: term to mint under https://w3id.org/gppd-ld/ (prefix gppd:)&lt;br&gt;&lt;span style=&quot;color:#2E7D32&quot;&gt;Green&lt;/span&gt;: values taken from a gppd SKOS concept scheme&lt;br&gt;Dashed blue box: external resource that the data links to (e.g. Wikidata)&lt;br&gt;[1] exactly one, [0..1] optional, [0..3] up to three, [0..n] any number" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#999999;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1360" width="470" height="150" as="geometry" /></mxCell><mxCell id="px" value="&lt;b&gt;Prefixes and namespaces&lt;/b&gt;&lt;br&gt;dbo: http://dbpedia.org/ontology/&lt;br&gt;oeo: http://openenergy-platform.org/ontology/oeo/&lt;br&gt;geo: http://www.opengis.net/ont/geosparql#&lt;br&gt;sf: http://www.opengis.net/ont/sf#&lt;br&gt;prov: http://www.w3.org/ns/prov#&lt;br&gt;adms: http://www.w3.org/ns/adms#&lt;br&gt;dcterms: http://purl.org/dc/terms/&lt;br&gt;rdfs: http://www.w3.org/2000/01/rdf-schema#&lt;br&gt;owl: http://www.w3.org/2002/07/owl#&lt;br&gt;skos: http://www.w3.org/2004/02/skos/core#&lt;br&gt;dcat: http://www.w3.org/ns/dcat#&lt;br&gt;qb: http://purl.org/linked-data/cube#&lt;br&gt;sdmx-*: http://purl.org/linked-data/sdmx/2009/...#&lt;br&gt;unit: http://qudt.org/vocab/unit/&lt;br&gt;country: http://publications.europa.eu/resource/authority/country/&lt;br&gt;&lt;span style=&quot;color:#B85450&quot;&gt;gppd: https://w3id.org/gppd-ld/ontology#&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#999999;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1180" y="1360" width="420" height="270" as="geometry" /></mxCell><mxCell id="e1" value="geo:hasGeometry [1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.0625;exitDx=0;exitD